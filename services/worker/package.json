{
  "name": "@libredi/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Libredi worker service",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node26 --sourcemap --outfile=dist/main.js",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@libredi/service-kit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
