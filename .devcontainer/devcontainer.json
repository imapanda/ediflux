{
  "name": "Libredi",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "26.12.1",
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.27.3"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "postCreateCommand": "npm install --global pnpm@12.15.0 && pnpm install --frozen-lockfile && scripts/init-env.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Libredi proxy" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome", "golang.go", "EditorConfig.EditorConfig"],
      "settings": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "[go]": { "editor.defaultFormatter": "golang.go" }
      }
    }
  }
}
