# Configuration of the Compose stack. Copy to .env, or run scripts/init-env.sh, which
# copies it and generates a password. Never commit .env.

# Password of the PostgreSQL user "libredi". Required: there is no default value.
POSTGRES_PASSWORD=

# Port of the reverse proxy on 127.0.0.1. It is the only port published on the host:
# services are reached through the proxy, so that --scale works.
LIBREDI_PORT=8080

# Host names the proxy answers to (space separated). Requests with another Host header get
# HTTP 421, which blocks DNS rebinding. Add your domain when you expose Libredi.
LIBREDI_HOSTS=localhost 127.0.0.1
