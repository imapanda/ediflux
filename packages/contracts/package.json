{
  "name": "@libredi/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Types generated from the canonical document schemas, and checks that the files in contracts/ are valid and that services honour them",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "generate": "node src/generate-types.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "catalog:",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "fast-check": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "exports": {
    "./canonical/v1": "./src/generated/canonical-v1.ts"
  }
}
