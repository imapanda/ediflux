# https://editorconfig.org, checked in CI by editorconfig-checker.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go code (gofmt) and the Caddyfile (caddy fmt) are indented with tabs.
[{*.go,Caddyfile}]
indent_style = tab
indent_size = unset

# Markdown list continuations and the license text use free-form indentation.
[{*.md,LICENSE}]
indent_size = unset

# Sample EDI messages must stay byte-for-byte identical to what partners send:
# CRLF or no line breaks at all, no final newline, other character sets.
[*.{edi,edifact,x12}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# Fictitious directory files for the tests of the registry generator. They imitate the layout of the
# UN/EDIFACT directory files, which is made of columns, so their indentation is not a multiple of two.
[packages/registry/src/test-support/fixtures/**]
indent_size = unset

# Load test (perf/pgmq): its SQL is aligned by hand, and the raw output of psql and pgbench is
# kept exactly as printed.
[perf/pgmq/sql/*.sql]
indent_size = unset

[perf/pgmq/results/*]
indent_size = unset
trim_trailing_whitespace = unset
